---
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
import ProductSection from "../components/ProductSection.astro";
import Layout from "../layouts/Layout.astro";
import { productGroups } from "../data/products";
---

<Layout
  title="Pastas artesanales para pedir por WhatsApp"
  description="Landing page de sorrentinos y raviolones artesanales con dise\u00f1o editorial c\u00e1lido y CTA directo a WhatsApp."
>
  <main>
    <Hero />
    <ProductSection
      title="Productos y variedades"
      intro="Pastas caseras e ingredientes naturales, ideales para cualquier salsa."
      groups={productGroups}
    />
  </main>
  <Footer />
</Layout>

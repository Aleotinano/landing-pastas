---
import { whatsappNumber } from "../config";

const whatsappUrl =
  `https://wa.me/${whatsappNumber}?text=` +
  encodeURIComponent("Hola, quiero pedir pastas caseras");
---

<div class="relative pb-36 sm:pb-20 lg:pb-0">
  <section
    class="relative pb-52 sm:pb-32
           pt-18 sm:pt-15
           px-4 sm:px-6 lg:px-8
           bg-[url('/hero.jpg')] bg-cover bg-center overflow-visible"
  >
    <div class="absolute inset-0 bg-black/50"></div>

    <div
      class="absolute left-6 top-8 h-32 w-32 rounded-full bg-earth/80 blur-3xl z-0"
    >
    </div>
    <div
      class="absolute right-8 bottom-15 h-40 w-40 rounded-full bg-primary/80 blur-3xl z-0"
    >
    </div>

    <div class="mx-auto max-w-7xl relative z-10">
      <div
        class="sm:max-w-3/4 lg:max-w-1/2 flex flex-col gap-6
                justify-center sm:justify-start
                items-center sm:items-start"
      >
        <h1
          class="text-nowrap font-display leading-none text-cream text-6xl lg:text-8xl"
        >
          Pastas caseras
        </h1>
        <p
          class="px-2
                text-center sm:text-left
                text-lg sm:text-xl
                leading-7 text-cream
                mb-1"
        >
          Sorrentinos y raviolones rellenos, hechos para resolver una comida
          rica, casera y visualmente irresistible. Elegís tu variedad y pedís
          directo por WhatsApp.
        </p>
        <div>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center justify-center
                   rounded-full bg-primary px-7 py-4 text-sm font-semibold uppercase tracking-[0.2em]
                 text-cream transition hover:bg-accent"
          >
            Pedir por WhatsApp
          </a>
        </div>
      </div>

      <div
        class="absolute
             left-1/2 -translate-x-1/2 sm:left-auto sm:translate-x-0 sm:right-0
             -bottom-8 sm:bottom-0 translate-y-full sm:translate-y-4/5 lg:translate-y-3/5
             z-20
             w-62 lg:w-76"
      >
        <div
          class="relative aspect-6/8 rounded-4xl border border-white/50 bg-cream p-2 shadow-md overflow-hidden"
        >
          <img
            src="./cardHero.png"
            alt="Plato de pasta fresca artesanal"
            class="h-full w-full rounded-3xl object-cover"
            loading="eager"
          />
          <span class="absolute inset-x-6 bottom-6 flex flex-col gap-2">
            <header class="rounded-4xl bg-white/80 p-1 backdrop-blur">
              <a
                href="#productos"
                class="inline-flex items-center justify-center rounded-full bg-primary/90
                   py-2.5 sm:py-3 text-xs sm:text-sm font-semibold uppercase
                   tracking-[0.2em] text-cream transition hover:bg-primary w-full"
              >
                Ver productos
              </a>
            </header>
            <footer class="rounded-4xl bg-white/70 p-3 backdrop-blur">
              <p
                class="text-xs uppercase tracking-[0.2em] text-earth text-center font-bold whitespace-nowrap"
              >
                Cajas de 20 unidades
              </p>
            </footer>
          </span>
        </div>
      </div>
    </div>
  </section>
</div>

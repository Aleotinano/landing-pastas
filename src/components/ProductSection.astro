---
import ProductCard from "./ProductCard.astro";
import type { Group } from "../types/types";

interface Props {
  title: string;
  intro: string;
  groups: readonly Group[];
}

const { title, intro, groups } = Astro.props;
---

<section
  id="productos"
  class="mx-auto max-w-7xl
 		 px-4 py-14 sm:px-6 lg:px-8 lg:py-20
		 flex flex-col gap-8"
>
  <header class="flex flex-col
			  items-center sm:items-start
			  gap-1 max-w-3xl">
    <p class="text-md font-semibold uppercase tracking-[0.2em] text-earth mb-2">
      Catálo
    </p>
    <h2
      class="font-display leading-none text-text
	  		 text-4xl sm:text-5xl lg:text-6xl
			  text-center sm:text-start"
    >
      {title}
    </h2>
    <p
      class="max-w-2xl text-base sm:text-lg leading-7 text-earth
			 text-center sm:text-start"
    >
      {intro}
    </p>
  </header>

  <main class="flex flex-col gap-8">
    {
      groups.map((group) => (
        <section class="flex flex-col gap-5 md:gap-8">
          <header
            class="flex border-b border-earth/30 pb-5 
				   gap-2 sm:gap-8
		   		   flex-col sm:flex-row 
		   		   items-center sm:items-end shrink-0
				   "
          >
            <div class="flex flex-col gap-1">
              <p
                class="text-xs font-semibold uppercase tracking-[0.2em] text-earth
			 text-center sm:text-start 
			  "
              >
                {group.quantity}
              </p>
              <h3 class="font-display text-5xl leading-none text-text ">
                {group.name}
              </h3>
            </div>
            <p
              class="max-w-2xl leading-7 text-text/80
					 text-md sm:text-lg
					 text-center sm:text-start
					 "
            >
              {group.description}
            </p>
          </header>

          <div class="grid gap-5 md:grid-cols-2">
            {group.varieties.map((variety) => (
              <ProductCard type={group.name} variety={variety} />
            ))}
          </div>
        </section>
      ))
    }
  </main>
</section>

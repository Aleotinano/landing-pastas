---
import ProductCard from './ProductCard.astro';

interface ProductGroup {
	name: string;
	eyebrow: string;
	description: string;
	varieties: readonly string[];
}

interface Props {
	title: string;
	intro: string;
	groups: readonly ProductGroup[];
}

const { title, intro, groups } = Astro.props;
---

<section id="productos" class="px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
	<div class="mx-auto max-w-7xl">
		<div class="max-w-3xl">
			<p class="text-xs font-semibold uppercase tracking-[0.32em] text-earth">Catálogo</p>
			<h2 class="mt-4 font-display text-4xl leading-none text-ink sm:text-5xl lg:text-6xl">
				{title}
			</h2>
			<p class="mt-5 max-w-2xl text-base leading-7 text-mocha/80 sm:text-lg">{intro}</p>
		</div>

		<div class="mt-10 space-y-10">
			{
				groups.map((group) => (
					<section class="rounded-[2.25rem] bg-sand/70 p-6 shadow-soft ring-1 ring-white/50 sm:p-8 lg:p-10">
						<div class="flex flex-col gap-4 border-b border-earth/10 pb-6 sm:flex-row sm:items-end sm:justify-between">
							<div>
								<p class="text-xs font-semibold uppercase tracking-[0.3em] text-earth">{group.eyebrow}</p>
								<h3 class="mt-3 font-display text-4xl leading-none text-ink sm:text-5xl">{group.name}</h3>
							</div>
							<p class="max-w-2xl text-sm leading-7 text-mocha/80 sm:text-base">{group.description}</p>
						</div>

						<div class="mt-8 grid gap-5 md:grid-cols-2">
							{group.varieties.map((variety) => (
								<ProductCard
									type={group.name}
									variety={variety}
									description="Pasta fresca artesanal elaborada con relleno generoso y terminación casera, ideal para una comida rica sin complicaciones."
								/>
							))}
						</div>
					</section>
				))
			}
		</div>
	</div>
</section>

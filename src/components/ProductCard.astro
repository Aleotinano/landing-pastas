---
import { whatsappNumber } from "../config";
import type { Variety } from "../types/types";

interface Props {
  type: string;
  variety: Variety;
}

const { type, variety } = Astro.props;
const message = `Hola, quiero pedir ${type} de ${variety.name}`;
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
---

<article class="border-b border-text/40 py-2 bg-earth/10">
  <div class="px-2.5 sm:px-4 flex items-center justify-between gap-2 sm:gap-4">
    <div class="flex flex-col gap-4 min-w-42">
      <h3 class="font-display text-2xl leading-tight text-text">
        · {variety.name} ·
      </h3>
      <span class="flex gap-1 items-center">
        <p class="opacity-0">·</p>
        <p class="text-xs uppercase tracking-wide text-earth">Caja 20 u.</p>
        <p>·</p>
        <p class="text-base] font-medium text-text">
          $ {variety.price.toLocaleString("es-AR")}
        </p>
      </span>
    </div>
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noreferrer"
      class="rounded-full bg-primary/90 hover:bg-primary px-4
  			 py-3 text-xs font-medium uppercase tracking-widest text-white transition text-center"
    >
      Pedir ahora
    </a>
  </div>
</article>

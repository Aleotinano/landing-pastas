---
import { priceLabel, whatsappBaseUrl } from '../data/products';

interface Props {
	type: string;
	variety: string;
	description: string;
}

const { type, variety, description } = Astro.props;
const message = `Hola, quiero pedir ${type} de ${variety}`;
const whatsappUrl = `${whatsappBaseUrl}?text=${encodeURIComponent(message)}`;
---

<article class="group flex h-full flex-col rounded-[2rem] border border-white/55 bg-white/85 p-6 shadow-soft backdrop-blur transition hover:-translate-y-1 hover:shadow-card">
	<div class="flex items-start justify-between gap-4">
		<div>
			<p class="text-xs font-semibold uppercase tracking-[0.28em] text-earth">{type}</p>
			<h3 class="mt-3 font-display text-3xl leading-none text-ink">{variety}</h3>
		</div>
		<div class="rounded-full bg-apricot px-4 py-2 text-sm font-semibold text-ink">{priceLabel}</div>
	</div>

	<p class="mt-4 text-sm leading-7 text-mocha/80">{description}</p>

	<div class="mt-6 flex items-center justify-between gap-4 border-t border-earth/10 pt-5">
		<p class="text-xs uppercase tracking-[0.24em] text-earth">Caja de 20 unidades</p>
		<a
			href={whatsappUrl}
			target="_blank"
			rel="noreferrer"
			class="inline-flex items-center justify-center rounded-full bg-tomato px-5 py-3 text-xs font-semibold uppercase tracking-[0.2em] text-white transition hover:bg-ink"
		>
			Comprar por WhatsApp
		</a>
	</div>
</article>
